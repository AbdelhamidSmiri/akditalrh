# Copy to .env on the TARGET server. Never commit a real .env.

# --- Local WAMP ---
# APP_DEBUG=2
# FORCE_HTTPS=0
# MAIL_TRANSPORT=Debug

# --- External / staging / prod (your server) ---
APP_DEBUG=0
FORCE_HTTPS=1

# IP(s) / CIDR of the reverse proxy in front of Apache (comma-separated).
# Only these may set X-Forwarded-For / X-Forwarded-Proto. Empty = no proxy trusted.
TRUSTED_PROXIES=

# Public address users type in the browser (scheme + host, no trailing slash).
# Used for links in e-mails and redirects, so they never depend on request headers.
# Example: https://mgr.myakdital.ma   or   https://10.47.3.130
APP_BASE_URL=

# Comma-separated roles that MUST enable MFA. Empty = optional for all.
# Examples: Admin   or   Admin,Agence
MFA_REQUIRED_ROLES=Admin

# Generate NEW random values on each server (do not reuse local secrets on prod)
SECURITY_SALT=change_me_to_a_long_random_string_at_least_40_chars
SECURITY_CIPHER_SEED=1234567890123456789012345678901234567890
SECURITY_LEGACY_SALT=koko

# --- Email (external server) ---
MAIL_TRANSPORT=Smtp
MAIL_FROM=noreply@your-domain.tld
MAIL_FROM_NAME=Akdital MGR
SMTP_HOST=smtp.your-provider.tld
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=1
