{
	"name": "cakephp/app",
	"description": "CakePHP Application skeleton",
	"type": "project",
	"keywords": ["application", "cakephp"],
	"homepage": "https://cakephp.org",
	"license": "MIT",
	"authors": [
		{
			"name": "CakePHP Community",
			"homepage": "https://github.com/cakephp/cakephp/graphs/contributors"
		}
	],
	"require": {
		"php": ">=8.0",
		"pieceofcake2/cakephp": "~2.10.24.8"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"pieceofcake2/bake": "^1.0"
	},
	"suggest": {
		"cakephp/cakephp-codesniffer": "Easily check code formatting against the CakePHP coding standards."
	},
	"config": {
		"vendor-dir": "Vendor/",
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
